    <string name="changelog_date_1_1_0">February 26, 2026</string>
    <string name="changelog_date_1_0_0">Initial Release</string>
    <string name="changelog_summary_2_1_9">Major release featuring HyperOS Home redesign, Modal BottomSheet destination pickers for copy/move/extract, universal file and folder bookmarks, realtime kernel-level directory auto-refresh, spring-animated floating dock with clean dropdown menu, native MIUIX properties dialog with POSIX permissions (644/755), ColorOS 17 scoped search, and full Material You Monet theming.</string>
    <string name="changelog_summary_2_1_3">Added password encryption support for ZIP (AES-256 &amp; ZipCrypto), redesigned all popup dialogs to be clean and proportional, and fixed crash when viewing encrypted archives.</string>
    <string name="changelog_summary_2_1_0">Standalone OTA updates via GitHub Releases, MIUIX HyperOS UI mode, Recent Files manager, in-app HTML runner, raised Min SDK to Android 10, and comprehensive localization.</string>
    <string name="changelog_summary_2_0_0">Shizuku &amp; Root privileged access, multi-storage horizontal pager, native Rust payload parser, and Material 3 overhaul.</string>
    <string name="changelog_summary_1_1_0">Initial Android OTA Payload.bin extraction with Protocol Buffers, and streaming XZ/BZIP2 decompression.</string>
    <string name="changelog_summary_1_0_0">Initial release of XArchiver with essential archive handling and Material Design 3 file explorer.</string>
    <string name="changelog_item_2_1_9_folder_picker_title">Modal BottomSheet Destination Picker</string>
    <string name="changelog_item_2_1_9_folder_picker_desc">Replaced legacy desktop popup dialogs with native, mobile-optimized Modal BottomSheets for Copy, Move, and Extract operations in both Material 3 and MIUIX styles.</string>
    <string name="changelog_item_2_1_9_bookmarks_title">Universal File &amp; Folder Bookmarks</string>
    <string name="changelog_item_2_1_9_bookmarks_desc">Expanded bookmarks to support bookmarking any file or folder across storage with instant opening and dedicated management cards in both Material and MIUIX home screens.</string>
    <string name="changelog_item_2_1_9_selection_dock_title">Spring-Animated Selection Dock &amp; Clean Menu</string>
    <string name="changelog_item_2_1_9_selection_dock_desc">Overhauled the floating selection dock with macOS-inspired bouncy spring physics and scale transitions, interactive tactile button feedback, and a clean text-only WindowIconDropdownMenu matching HyperOS File Manager.</string>
    <string name="changelog_item_2_1_9_properties_title">Native MIUIX Details Dialog &amp; POSIX Permissions</string>
    <string name="changelog_item_2_1_9_properties_desc">Introduced native MiuixPropertiesDialog with MIUIX token styling, and upgraded file permission inspection to standard Linux POSIX format (e.g. 644 rw-r--r-- and 755 rwxr-xr-x).</string>
    <string name="changelog_item_2_1_9_miuix_home_title">MIUIX HyperOS Home Redesign</string>
    <string name="changelog_item_2_1_9_miuix_home_desc">Overhauled the MIUIX home screen to follow official HyperOS File Manager hierarchy with 2-column squircle category pills, consolidated Downloads &amp; Bookmarks quick access, modernized storage usage card with slim progress gauge &amp; filesystem badge, dedicated Sources section (Camera, Screenshots, Media), and dual-capsule floating navigation bar.</string>
    <string name="changelog_item_2_1_9_realtime_title">Realtime File &amp; Directory Auto-Refresh</string>
    <string name="changelog_item_2_1_9_realtime_desc">Introduced automated realtime directory watching via Linux kernel inotify (FileObserver) and lifecycle resume observer across Material and MIUIX explorers. Newly transferred files from PC (MTP/ADB), camera photos, browser downloads, or folders created in other apps appear instantly without leaving or re-entering the folder.</string>
    <string name="changelog_item_2_1_9_home_ui_title">Material Home Layout Redesign</string>
    <string name="changelog_item_2_1_9_home_ui_desc">Overhauled home screen layout with rearranged StorageCard (top badges, horizontal title, usage breakdown, and bottom progress bar), tiered category grid (2 wide cards for Images &amp; APK, 4 compact cards, and full-width Bookmarks/Favorites card with management bottom sheet), 2-column Quick Access grid, and floating pill capsule navigation bar adhering to native Material You theming.</string>
    <string name="changelog_item_2_1_9_search_title">Scoped Search &amp; XArcDeep Engine</string>
    <string name="changelog_item_2_1_9_search_desc">Directory-scoped intelligent search that strictly scans only the current folder, instant category filter chips (Images, Videos, Audio, Documents, Archives, APK), search query keyword highlighting, and one-tap XArcDeep to effortlessly expand search across the entire device.</string>
    <string name="changelog_item_2_1_9_viewmodes_title">Dynamic View Modes (List, Grid, Waterfall)</string>
    <string name="changelog_item_2_1_9_viewmodes_desc">Seamlessly switch between list view, Monet card grid view, and unboxed waterfall layout with persistent DataStore state.</string>
    <string name="changelog_item_2_1_9_topbar_title">Circular Action TopBar &amp; Breadcrumbs</string>
    <string name="changelog_item_2_1_9_topbar_desc">Modernized TopBar featuring circular action buttons (+, search, more) and an interactive horizontal breadcrumb bar.</string>
    <string name="changelog_item_2_1_9_monet_title">Material You Monet Dynamic Theming</string>
    <string name="changelog_item_2_1_9_monet_desc">Replaced hardcoded colors with system-derived Material 3 Monet dynamic tokens across backgrounds, card containers, and folder accents.</string>
    <string name="changelog_item_2_1_9_sort_title">Interactive Sorting Modal</string>
    <string name="changelog_item_2_1_9_sort_desc">Dedicated sort modal bottom sheet supporting sorting by Name, Date, Size, and Type in ascending or descending order.</string>
    <string name="changelog_item_2_1_9_i18n_title">Full Multilingual Localization (i18n)</string>
    <string name="changelog_item_2_1_9_i18n_desc">Migrated all explorer and search strings into Android string resources with complete English and Indonesian translations, ensuring seamless language switching.</string>
    <string name="changelog_item_2_1_9_miuix_title">Modular MIUIX &amp; HyperOS Explorer</string>
    <string name="changelog_item_2_1_9_miuix_desc">Dedicated HyperOS Explorer mode with breadcrumb pill chips, quick action docks, native operation dialogs, and a cleanly modularized codebase.</string>
    <string name="changelog_item_2_1_3_encryption_title">ZIP Password Encryption (AES-256 &amp; ZipCrypto)</string>
    <string name="changelog_item_2_1_3_encryption_desc">Full password encryption support when creating ZIP archives using either robust AES-256 or legacy ZipCrypto, with automatic password prompts upon opening or extracting.</string>
    <string name="changelog_item_2_1_3_dialogs_title">Proportional Dialog Redesign</string>
    <string name="changelog_item_2_1_3_dialogs_desc">Completely redesigned all popup dialogs across the application with balanced 50/50 action buttons, rounded icon headers, structured surface cards, and Material 3 styling.</string>
    <string name="changelog_item_2_1_3_crashfix_title">Encrypted Archive Crash Fix</string>
    <string name="changelog_item_2_1_3_crashfix_desc">Fixed a crash when tapping password-protected ZIP files in Explorer, now gracefully prompting for password and opening contents safely.</string>
    <string name="changelog_item_2_1_miuix_title">MIUIX HyperOS Design System</string>
    <string name="changelog_item_2_1_miuix_desc">Complete visual overhaul with squircle cards, real-time texture blur, and HyperOS aesthetics.</string>
    <string name="changelog_item_2_1_recent_title">Recent Files Manager</string>
    <string name="changelog_item_2_1_recent_desc">Track recently accessed, modified, and extracted files with an interactive home tab and text marquee.</string>
    <string name="changelog_item_2_1_specs_title">Dedicated Specs &amp; Formats Screens</string>
    <string name="changelog_item_2_1_specs_desc">New full-page views for detailed application architecture, system info, and supported archive types.</string>
    <string name="changelog_item_2_1_autodetect_title">Intelligent Device Auto-Detection</string>
    <string name="changelog_item_2_1_autodetect_desc">Automatically enables MIUIX mode on Xiaomi, Redmi, and Poco devices running MIUI or HyperOS.</string>
    <string name="changelog_item_2_1_minsdk_title">Android 10 (API 29) Minimum SDK</string>
    <string name="changelog_item_2_1_minsdk_desc">Raised minimum SDK from Android 8.0 to Android 10 with manifest library overrides for modern API support.</string>
    <string name="changelog_item_2_1_i18n_title">Full Bilingual Localization</string>
    <string name="changelog_item_2_1_i18n_desc">Complete resource-based localization for About, Specs, Formats, and Changelogs in English and Indonesian.</string>
    <string name="changelog_item_2_1_perf_title">List Scrolling &amp; Memory Optimization</string>
    <string name="changelog_item_2_1_perf_desc">Optimized folder scrolling performance with LazyColumn item recycling, APK icon memory caching (LruCache), eliminated heavy touch animations, and reduced render overdraw.</string>
    <string name="changelog_item_2_1_html_title">In-App HTML Web Runner &amp; Preview</string>
    <string name="changelog_item_2_1_html_desc">Directly run and render HTML websites with a dedicated Play button inside the text editor, featuring live reload, relative resource support, and mobile/desktop viewport toggle.</string>
    <string name="changelog_item_2_1_ota_title">Standalone OTA Updates &amp; Markdown Viewer</string>
    <string name="changelog_item_2_1_ota_desc">Automated GitHub Releases updates without Firebase, adaptive MIUIX and Material 3 update screens, interactive progress-filling pill download button, and rich Markdown release notes rendering.</string>
    <string name="changelog_item_2_0_root_title">Shizuku &amp; Root Privileged Access</string>
    <string name="changelog_item_2_0_root_desc">Read, write, and edit protected system files using Shizuku API v13+ or superuser (su) via libsu 6.0.</string>
    <string name="changelog_item_2_0_storage_title">Multi-Storage Horizontal Pager</string>
    <string name="changelog_item_2_0_storage_desc">Effortlessly swipe between Internal, SD Card, USB OTG, and Root with auto-detection of filesystem types (F2FS, ext4).</string>
    <string name="changelog_item_2_0_payload_title">Rust Native Payload Parser</string>
    <string name="changelog_item_2_0_payload_desc">Blazing fast Android OTA payload.bin extraction with partition inspection and SHA256 integrity checks.</string>
    <string name="changelog_item_2_0_m3_title">Material 3 &amp; Dynamic Island</string>
    <string name="changelog_item_2_0_m3_desc">Expressive color palette with AMOLED dark mode and animated floating notification pill banners.</string>
    <string name="changelog_item_2_0_explorer_title">Enhanced Explorer &amp; Media Thumbnails</string>
    <string name="changelog_item_2_0_explorer_desc">Multi-select file actions, batch operations, APK icon extraction, and Coil image/video preview thumbnails.</string>
    <string name="changelog_item_1_1_payload_title">Android OTA Payload.bin Support</string>
    <string name="changelog_item_1_1_payload_desc">Parse OTA manifests with Protocol Buffers and extract partitions directly to .img files.</string>
    <string name="changelog_item_1_1_streaming_title">Streaming Decompression</string>
    <string name="changelog_item_1_1_streaming_desc">Memory-efficient on-the-fly XZ/LZMA and BZIP2 decompression with real-time byte-level progress.</string>
    <string name="changelog_item_1_1_fixes_title">Flow Invariant &amp; OOM Fixes</string>
    <string name="changelog_item_1_1_fixes_desc">Resolved Flow invariant crash on archive previews and prevented OutOfMemoryError on large binary files.</string>
    <string name="changelog_item_1_0_initial_title">Initial Release</string>
    <string name="changelog_item_1_0_initial_desc">Core file manager and archive utility supporting ZIP, TAR, GZ, and TGZ with Material Design 3.</string>

