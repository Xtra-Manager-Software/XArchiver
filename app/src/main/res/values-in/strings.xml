    <string name="changelog_date_1_1_0">26 Februari 2026</string>
    <string name="changelog_date_1_0_0">Rilis Perdana</string>
    <string name="changelog_summary_2_1_9">Pembaruan besar Explorer dan Beranda menghadirkan tata letak baru Material Home, sistem pencarian terlingkup gaya ColorOS 17 dengan XArcDeep, filter kategori instan berbasis chip, penyorotan kata kunci kueri, 3 mode tampilan dinamis (Daftar, Kisi, Air Terjun), TopBar tombol lingkaran, navigasi breadcrumb, dan palet dinamis Monet.</string>
    <string name="changelog_summary_2_1_3">Penambahan enkripsi kata sandi untuk ZIP (AES-256 &amp; ZipCrypto), desain ulang seluruh popup dialog agar rapi dan proporsional, serta perbaikan crash pada arsip berpassword.</string>
    <string name="changelog_summary_2_1_0">Pembaruan mandiri OTA via GitHub Releases, antarmuka MIUIX HyperOS, pengelola Berkas Terkini, runner HTML dalam aplikasi, peningkatan SDK Minimum ke Android 10, dan lokalisasi lengkap.</string>
    <string name="changelog_summary_2_0_0">Akses istimewa Shizuku &amp; Root, pager horizontal multi-penyimpanan, parser payload native Rust, dan perombakan Material 3.</string>
    <string name="changelog_summary_1_1_0">Dukungan awal ekstraksi Android OTA Payload.bin dengan Protocol Buffers, dan dekompresi streaming XZ/BZIP2.</string>
    <string name="changelog_summary_1_0_0">Rilis perdana XArchiver dengan penanganan arsip inti dan pengelola berkas Material Design 3.</string>
    <string name="changelog_item_2_1_9_miuix_home_title">Desain Ulang Beranda MIUIX HyperOS</string>
    <string name="changelog_item_2_1_9_miuix_home_desc">Merombak total tampilan Beranda MIUIX mengadopsi hierarki resmi File Manager HyperOS dengan pil kategori 2 kolom bersudut squircle, akses cepat Unduhan &amp; Favorit terpadu, kartu penyimpanan modern dengan indikator baris tipis &amp; badge sistem berkas, bagian Sumber terdedikasi (Kamera, Screenshot, Media), dan bilah navigasi floating kapsul ganda.</string>
    <string name="changelog_item_2_1_9_realtime_title">Penyegaran Berkas &amp; Folder Otomatis Realtime</string>
    <string name="changelog_item_2_1_9_realtime_desc">Menghadirkan pemantauan berkas waktu-nyata berbasis inotify kernel Linux (FileObserver) dan pengamat status aplikasi (ON_RESUME) di penjelajah Material dan MIUIX. Berkas baru yang ditransfer dari PC (MTP/ADB), foto kamera, unduhan browser, atau folder dari aplikasi lain langsung muncul seketika secara hening tanpa harus keluar dan masuk kembali ke folder.</string>
    <string name="changelog_item_2_1_9_home_ui_title">Desain Ulang Tata Letak Beranda Material</string>
    <string name="changelog_item_2_1_9_home_ui_desc">Pembaruan tata letak kartu Penyimpanan (badge status di atas, judul berdampingan horizontal, rincian kapasitas, dan progress bar linier), grid kategori bertingkat (2 kartu lebar Images &amp; APK, 4 kartu kompak, serta kartu penuh Favorit/Bookmarks dengan bottom sheet pengelola), kisi 2 kolom Akses Cepat, dan bilah navigasi floating kapsul dengan tema Material You murni.</string>
    <string name="changelog_item_2_1_9_search_title">Pencarian Terlingkup &amp; Mesin XArcDeep</string>
    <string name="changelog_item_2_1_9_search_desc">Pencarian cerdas terlingkup direktori aktif yang secara eksklusif hanya menelusuri folder saat ini, filter kategori geser instan (Gambar, Video, Audio, Dokumen, Arsip, APK), penyorotan kata kunci kueri, dan opsi XArcDeep untuk memperluas pencarian ke seluruh perangkat secara instan.</string>
    <string name="changelog_item_2_1_9_viewmodes_title">Mode Tampilan Dinamis (Daftar, Kisi, Air Terjun)</string>
    <string name="changelog_item_2_1_9_viewmodes_desc">Beralih cepat antara tampilan daftar default, tampilan kisi kartu Monet, dan tampilan air terjun bersih dengan preferensi tersimpan di DataStore.</string>
    <string name="changelog_item_2_1_9_topbar_title">TopBar Tombol Lingkaran &amp; Breadcrumb</string>
    <string name="changelog_item_2_1_9_topbar_desc">Bilah atas modern dengan tombol aksi lingkaran untuk navigasi, tambah berkas/folder, cari, dan opsi menu serta bilah breadcrumb interaktif.</string>
    <string name="changelog_item_2_1_9_monet_title">Integrasi Penuh Palet Monet Material You</string>
    <string name="changelog_item_2_1_9_monet_desc">Warna latar belakang, kontainer kartu, tombol, dan ikon folder/berkas terikat langsung pada tema dinamis sistem tanpa warna hardcoded hitam/biru.</string>
    <string name="changelog_item_2_1_9_sort_title">Modal Pengurutan Persisten</string>
    <string name="changelog_item_2_1_9_sort_desc">Modal sheet pengurutan interaktif berdasarkan nama, tanggal, ukuran, dan tipe berkas secara naik maupun turun.</string>
    <string name="changelog_item_2_1_9_i18n_title">Dukungan Multibahasa Penuh (i18n)</string>
    <string name="changelog_item_2_1_9_i18n_desc">Memindahkan seluruh teks penjelajah dan sistem pencarian ke berkas sumber daya strings dengan terjemahan lengkap Bahasa Indonesia dan Bahasa Inggris, tanpa teks yang ter-hardcode.</string>
    <string name="changelog_item_2_1_9_miuix_title">Arsitektur Modular MIUIX &amp; HyperOS Explorer</string>
    <string name="changelog_item_2_1_9_miuix_desc">Antarmuka khusus MIUIX Explorer dengan chip breadcrumb, dock aksi seleksi cepat, dialog operasi native HyperOS, dan arsitektur kode modular yang terstruktur.</string>
    <string name="changelog_item_2_1_3_encryption_title">Enkripsi Kata Sandi ZIP (AES-256 &amp; ZipCrypto)</string>
    <string name="changelog_item_2_1_3_encryption_desc">Dukungan penuh enkripsi kata sandi saat membuat arsip ZIP menggunakan AES-256 atau ZipCrypto, dengan dialog permintaan kata sandi otomatis saat dibuka atau diekstrak.</string>
    <string name="changelog_item_2_1_3_dialogs_title">Desain Ulang Dialog Proporsional</string>
    <string name="changelog_item_2_1_3_dialogs_desc">Merapikan seluruh popup dialog di aplikasi dengan tombol aksi simetris 50/50, wadah ikon header ber-radius, card terstruktur, dan estetika Material 3.</string>
    <string name="changelog_item_2_1_3_crashfix_title">Perbaikan Crash Arsip Berpassword</string>
    <string name="changelog_item_2_1_3_crashfix_desc">Memperbaiki crash saat mengklik berkas ZIP berpassword di Explorer, kini langsung memunculkan dialog kata sandi dengan aman dan lancar.</string>
    <string name="changelog_item_2_1_miuix_title">Sistem Desain MIUIX HyperOS</string>
    <string name="changelog_item_2_1_miuix_desc">Perombakan visual total dengan kartu squircle, efek blur tekstur real-time, dan estetika HyperOS.</string>
    <string name="changelog_item_2_1_recent_title">Pengelola Berkas Terkini</string>
    <string name="changelog_item_2_1_recent_desc">Lacak berkas yang baru diakses, diubah, dan diekstrak dengan tab beranda interaktif serta teks berjalan.</string>
    <string name="changelog_item_2_1_specs_title">Layar Khusus Spesifikasi &amp; Format</string>
    <string name="changelog_item_2_1_specs_desc">Tampilan halaman penuh baru untuk detail arsitektur aplikasi, info sistem, dan tipe arsip yang didukung.</string>
    <string name="changelog_item_2_1_autodetect_title">Deteksi Otomatis Perangkat Cerdas</string>
    <string name="changelog_item_2_1_autodetect_desc">Mengaktifkan mode MIUIX secara otomatis pada perangkat Xiaomi, Redmi, dan Poco yang menjalankan MIUI atau HyperOS.</string>
    <string name="changelog_item_2_1_minsdk_title">SDK Minimum Android 10 (API 29)</string>
    <string name="changelog_item_2_1_minsdk_desc">Menaikkan SDK minimum dari Android 8.0 ke Android 10 dengan override pustaka manifest untuk dukungan API modern.</string>
    <string name="changelog_item_2_1_i18n_title">Lokalisasi Bilingual Penuh</string>
    <string name="changelog_item_2_1_i18n_desc">Lokalisasi berbasis resource lengkap untuk Tentang, Spesifikasi, Format, dan Catatan Rilis dalam Bahasa Inggris dan Bahasa Indonesia.</string>
    <string name="changelog_item_2_1_perf_title">Optimasi Scrolling &amp; Memori</string>
    <string name="changelog_item_2_1_perf_desc">Peningkatan performa scrolling daftar folder dengan daur ulang item LazyColumn, cache memori ikon APK (LruCache), penghapusan animasi sentuh yang berat, dan reduksi overdraw render.</string>
    <string name="changelog_item_2_1_html_title">Runner &amp; Pratinjau Web HTML Dalam Aplikasi</string>
    <string name="changelog_item_2_1_html_desc">Jalankan dan render situs web HTML secara langsung dengan tombol Play di dalam text editor, mendukung live reload, aset relatif (CSS/JS/gambar), serta beralih tampilan ponsel/desktop.</string>
    <string name="changelog_item_2_1_ota_title">Pembaruan Mandiri (OTA) &amp; Penampil Markdown</string>
    <string name="changelog_item_2_1_ota_desc">Pembaruan aplikasi otomatis via GitHub Releases tanpa Firebase, layar pembaruan adaptif MIUIX dan Material 3, tombol kapsul progres interaktif (progress-filling pill), dan render catatan rilis berbasis Markdown.</string>
    <string name="changelog_item_2_0_root_title">Akses Khusus Shizuku &amp; Root</string>
    <string name="changelog_item_2_0_root_desc">Membaca, menulis, dan mengedit berkas sistem terlindungi menggunakan Shizuku API v13+ atau superuser (su) via libsu 6.0.</string>
    <string name="changelog_item_2_0_storage_title">Pager Horizontal Multi-Penyimpanan</string>
    <string name="changelog_item_2_0_storage_desc">Geser mudah antara Internal, Kartu SD, USB OTG, dan Root dengan deteksi otomatis sistem berkas (F2FS, ext4).</string>
    <string name="changelog_item_2_0_payload_title">Parser Payload Native Rust</string>
    <string name="changelog_item_2_0_payload_desc">Ekstraksi berkas payload.bin OTA Android super cepat dengan inspeksi partisi dan verifikasi integritas SHA256.</string>
    <string name="changelog_item_2_0_m3_title">Material 3 &amp; Dynamic Island</string>
    <string name="changelog_item_2_0_m3_desc">Palet warna ekspresif dengan tema gelap AMOLED dan floating notification pill beranimasi.</string>
    <string name="changelog_item_2_0_explorer_title">Peningkatan Penjelajah &amp; Thumbnail Media</string>
    <string name="changelog_item_2_0_explorer_desc">Aksi multi-pilih berkas, operasi batch, ekstraksi ikon APK, dan thumbnail pratinjau gambar/video dengan Coil.</string>
    <string name="changelog_item_1_1_payload_title">Dukungan Android OTA Payload.bin</string>
    <string name="changelog_item_1_1_payload_desc">Mengurai manifest OTA dengan Protocol Buffers dan mengekstrak partisi langsung ke berkas .img.</string>
    <string name="changelog_item_1_1_streaming_title">Dekompresi Streaming</string>
    <string name="changelog_item_1_1_streaming_desc">Dekompresi XZ/LZMA dan BZIP2 hemat memori secara real-time dengan pemantauan progres per-byte.</string>
    <string name="changelog_item_1_1_fixes_title">Perbaikan Flow Invariant &amp; OOM</string>
    <string name="changelog_item_1_1_fixes_desc">Memperbaiki crash Flow invariant pada pratinjau arsip dan mencegah OutOfMemoryError pada berkas biner besar.</string>
    <string name="changelog_item_1_0_initial_title">Rilis Perdana</string>
    <string name="changelog_item_1_0_initial_desc">Pengelola berkas dan utilitas arsip inti yang mendukung ZIP, TAR, GZ, dan TGZ dengan Material Design 3.</string>

